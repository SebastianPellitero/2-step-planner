generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  places Place[]
  trips  Trip[]

  @@map("users")
}

enum PlaceType {
  RESTAURANT
  MUSEUM
  HIKE
  HOTEL
  NATURE
  TEMPLE
  BEACH
  MARKET
  BAR
  SHOP
  OTHER
}

model Place {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  // Rich location fields from the search provider
  address         String?
  city            String?
  country         String?
  latitude        Float?
  longitude       Float?
  locationPlaceId String?   // Provider-specific ID (e.g. Mapbox feature ID)
  // Legacy coords kept for backwards compat — prefer latitude/longitude
  lat             Float     @default(0)
  lng             Float     @default(0)
  type            PlaceType
  notes           String?
  visited         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips PlaceTrip[]

  @@map("places")
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  places PlaceTrip[]

  @@map("trips")
}

model PlaceTrip {
  placeId    String
  tripId     String
  orderIndex Int    @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([placeId, tripId])
  @@map("place_trips")
}
